<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Nur Apps mit derselben Unterschrift (also die beiden Partner-Apps) dürfen die Daten lesen. -->
    <permission
        android:name="de.waslese.DATEN"
        android:label="Bücher und Lesetagebuch lesen"
        android:protectionLevel="signature" />

    <uses-permission android:name="de.waslese.DATEN" />

    <application>
        <provider
            android:name="de.waslese.gemeinsam.DatenProvider"
            android:authorities="${applicationId}.daten"
            android:exported="true"
            android:readPermission="de.waslese.DATEN"
            android:writePermission="de.waslese.DATEN" />
    </application>
</manifest>
